rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ──────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function ownsExistingDoc() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function ownsNewDoc() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // ── Rate limiting helpers (S3) ───────────────────────────────
    function cooldownElapsed(field) {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || !(field in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
        || request.time - get(/databases/$(database)/documents/users/$(request.auth.uid)).data[field] > duration.value(60, 's');
    }

    // ─── 1. Users ──────────────────────────────────────────────
    match /users/{userId} {
      allow read, update, delete: if isOwner(userId) || isAdmin();
      allow create: if signedIn() && request.auth.uid == userId;
    }

    // ─── 2. Providers ──────────────────────────────────────────
    match /providers/{providerId} {
      allow read: if true;
      allow create: if signedIn() && (request.auth.uid == providerId || getUserData().role == 'provider' || isAdmin());
      allow update: if isAdmin() || (signedIn() && (request.auth.uid == providerId || resource.data.email == request.auth.token.email));
      allow delete: if isAdmin();
    }

    // ─── 3. Bookings ───────────────────────────────────────────
    match /bookings/{bookingId} {
      allow read: if isAdmin() || (signedIn() && (resource.data.userId == request.auth.uid || resource.data.providerId == request.auth.uid));
      allow create: if signedIn() && cooldownElapsed('lastBookingAt');
      allow update: if isAdmin() || (signedIn() && (resource.data.userId == request.auth.uid || resource.data.providerId == request.auth.uid));
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    // ─── 4. Payments ───────────────────────────────────────────
    match /payments/{paymentId} {
      allow read: if isAdmin() || (signedIn() && (resource.data.customerId == request.auth.uid || resource.data.providerId == request.auth.uid));
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // ─── 5. Reviews ────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && getUserData().role != 'provider'
        && request.resource.data.userId == request.auth.uid
        && cooldownElapsed('lastReviewAt');
      allow update: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    // ─── 6. Pets ───────────────────────────────────────────────
    match /pets/{petId} {
      allow create: if ownsNewDoc() || isAdmin();
      allow get, list: if ownsExistingDoc() || isAdmin();
      allow update: if isAdmin()
        || (
          ownsExistingDoc()
          && request.resource.data.userId == request.auth.uid
        );
      allow delete: if ownsExistingDoc() || isAdmin();
    }

    // ─── 7. Favorites ──────────────────────────────────────────
    match /favorites/{favoriteId} {
      allow create: if ownsNewDoc() || isAdmin();
      allow get, list: if ownsExistingDoc() || isAdmin();
      allow update: if isAdmin()
        || (
          ownsExistingDoc()
          && request.resource.data.userId == request.auth.uid
        );
      allow delete: if ownsExistingDoc() || isAdmin();
    }

    // ─── 8. Contact Messages ───────────────────────────────────
    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
